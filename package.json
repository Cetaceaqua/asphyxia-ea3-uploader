{
  "name": "asphyxia-ea3-uploader",
  "version": "1.0.0",
  "description": "Standalone Konami EA3 Photo & Media Upload Server with WebUI Dashboard",
  "main": "./dist/server.js",
  "bin": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server.ts",
    "serve": "node dist/server.js",
    "package": "npm run build && pkg . --targets node18-win-x64 --output bin/asphyxia-ea3-uploader.exe"
  },
  "pkg": {
    "assets": [
      "views/**/*",
      "public/**/*"
    ]
  },
  "keywords": [
    "asphyxia",
    "e-amusement",
    "konami",
    "ea3",
    "uploader",
    "loveplus"
  ],
  "author": "Cetaceaqua",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ini": "^4.1.2",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ini": "^1.3.33",
    "@types/node": "^20.14.9",
    "@types/pug": "^2.0.10",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
