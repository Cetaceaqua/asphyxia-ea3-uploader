extends layout

block content
  .box.has-background-dark.mb-5
    .columns.is-variable.is-2.is-vcentered
      .column.is-5
        .field
          label.label.is-small.has-text-grey-light Game Model
          .control.has-icons-left
            .select.is-small.is-fullwidth
              select#gameFilter
                option(value="") All Games
                each game in gameList
                  option(value=game.model) #{game.title}
            span.icon.is-small.is-left
              i.mdi.mdi-gamepad-variant

      .column.is-5
        .field
          label.label.is-small.has-text-grey-light Player Reference ID
          .control.has-icons-left
            .select.is-small.is-fullwidth
              select#userFilter
                option(value="") All Players
                each user in userList
                  option(value=user) #{user}
            span.icon.is-small.is-left
              i.mdi.mdi-card-account-details

      .column.is-2.has-text-right-tablet
        label.label.is-small.is-hidden-mobile &nbsp;
        button#refreshBtn.button.is-small.is-primary.is-outlined.is-fullwidth
          span.icon
            i.mdi.mdi-refresh
          span Refresh

  if photos.length === 0
    .box.has-text-centered.py-6
      span.icon.is-large.has-text-grey
        i.mdi.mdi-image-off.mdi-48px
      p.title.is-5.has-text-grey.mt-3 No photos uploaded yet
      p.subtitle.is-6.has-text-grey-light Photos uploaded in games will appear here.
  else
    #photoGrid.columns.is-multiline
      each photo in photos
        .column.is-4-desktop.is-6-tablet.photo-card-item(
          data-refid=photo.refId
          data-game=photo.gameTitle
          data-model=photo.gameModel
          data-type=photo.imageType
          data-filename=photo.fileName
          data-time=photo.uploadTime
          data-is-card=(photo.isCard ? "true" : "false")
          data-card-id=(photo.cardId || "")
          data-front-url=(photo.frontUrl || photo.url)
          data-back-url=(photo.backUrl || "")
          data-holo-url=(photo.holoUrl || "")
          data-ir-url=(photo.irUrl || "")
          data-has-holo=(photo.hasHolo ? "true" : "false")
          data-has-back=(photo.hasBack ? "true" : "false")
          data-orientation=(photo.orientation || "portrait")
          data-card-meta=(photo.cardMeta ? JSON.stringify(photo.cardMeta) : "")
        )
          .card.photo-card
            .card-image
              figure.image.photo-thumb-container(
                style=(photo.orientation === 'landscape' ? "aspect-ratio: 1024 / 662;" : "aspect-ratio: 662 / 1024;")
              )
                img.photo-thumb(src=(photo.frontUrl || photo.url) alt=photo.fileName loading="lazy")
                if photo.imageType === 'Shinki Card' && photo.hasHolo && photo.holoUrl
                  .photo-thumb-holo(
                    style=`-webkit-mask-image: url('${photo.holoUrl}'); mask-image: url('${photo.holoUrl}');`
                  )
                .photo-overlay
                  button.button.is-small.is-primary.btn-preview(
                    data-url=(photo.frontUrl || photo.url)
                    data-title=photo.gameTitle
                    data-model=photo.gameModel
                    data-type=photo.imageType
                    data-refid=photo.refId
                    data-time=photo.uploadTime
                    data-size=(photo.fileSizeBytes / 1024).toFixed(1) + " KB"
                    data-filename=photo.fileName
                    data-is-card="true"
                    data-card-id=(photo.cardId || "")
                    data-front-url=(photo.frontUrl || photo.url)
                    data-back-url=(photo.backUrl || "")
                    data-holo-url=(photo.holoUrl || "")
                    data-ir-url=(photo.irUrl || "")
                    data-has-holo=(photo.hasHolo ? "true" : "false")
                    data-has-back=(photo.hasBack ? "true" : "false")
                    data-orientation=(photo.orientation || "portrait")
                    data-card-meta=(photo.cardMeta ? JSON.stringify(photo.cardMeta) : "")
                  )
                    span.icon
                      i.mdi.mdi-eye
                    span Detail
            .card-content.p-3
              .level.is-mobile.mb-1
                .level-left
                  .tags.has-addons.mb-0
                    span.tag.is-primary.is-light.is-small #{photo.gameModel || photo.gameTitle}
                    if photo.imageType
                      span.tag.is-info.is-light.is-small #{photo.imageType}
                    if photo.hasHolo
                      span.tag.holo-tag.is-small
                        span.icon.is-small
                          i.mdi.mdi-creation
                        span Holo
                    if photo.cardMeta && photo.cardMeta.rarity
                      span.tag.is-dark.rarity-stars.is-small #{'★'.repeat(photo.cardMeta.rarity)}
                .level-right
                  span.tag.is-dark.is-small #{(photo.fileSizeBytes / 1024).toFixed(1)} KB

              if photo.cardMeta && photo.cardMeta.description
                p.is-size-6.has-text-weight-bold.has-text-warning.text-truncate.mb-1(title=photo.cardMeta.description)
                  | #{photo.cardMeta.description}
                  if photo.cardMeta.holoName
                    span.is-size-7.has-text-grey-light.ml-2 [#{photo.cardMeta.holoName}]

              p.is-size-7.has-text-weight-semibold.has-text-grey-light.text-truncate(title=photo.fileName)
                | #{photo.fileName}

              .level.is-mobile.is-size-7.has-text-grey-light.mt-2
                .level-left
                  span.icon.is-small.mr-1
                    i.mdi.mdi-card-account-details-outline
                  span #{photo.refId}
                .level-right
                  span.icon.is-small.mr-1
                    i.mdi.mdi-clock-outline
                  span #{new Date(photo.timestamp).toLocaleDateString()}

            footer.card-footer
              a.card-footer-item.has-text-danger.is-size-7.btn-delete(
                href="#"
                data-refid=photo.refId
                data-filename=photo.fileName
              )
                span.icon.is-small
                  i.mdi.mdi-trash-can-outline
                span Delete

  #lightboxModal.modal
    .modal-background
    .modal-content.lightbox-content
      #cardStageSection.holo-stage-container
        .holo-stage-viewport
          #holoCardWrapper.holo-card-wrapper.is-portrait
            #holoCardRotator.holo-card-rotator
              #holoFaceFront.holo-card-face.face-front
                img#holoImgFront.holo-card-img(src="" alt="Front")
                #holoFoilContainer.holo-foil-container
                  #holoFoilBase.holo-foil-base
                  #holoFoilRainbow.holo-foil-rainbow
                  #holoFoilPattern.holo-foil-pattern
                .holo-glare
              #holoFaceBack.holo-card-face.face-back(style="display: none;")
                img#holoImgBack.holo-card-img(src="" alt="Back")
                .holo-glare

        .holo-controls-bar
          button#btnHoloFlip.button.is-small.is-dark
            span.icon
              i.mdi.mdi-rotate-3d-variant
            span.btn-label Flip
          button#btnHoloToggle.button.is-small.is-dark.is-active-toggle
            span.icon
              i.mdi.mdi-creation
            span.btn-label Holo
          .control
            .select.is-small
              select#holoPatternSelect
                option(value="basic") Glitter
                option(value="starlight") Starlight
                option(value="prismatic") Prismatic
                option(value="dots") Dot Matrix
          button#btnHoloAutoTilt.button.is-small.is-dark
            span.icon
              i.mdi.mdi-play-circle-outline
            span Auto

        .holo-info-panel
          h3#holoCardTitle.title.is-5.has-text-white.mb-2
          .holo-meta-row.mb-3
            #holoCardTags.holo-meta-tags
            .buttons.are-small.mb-0
              a#dlCardFront.button.is-primary.is-small(href="" download="")
                span.icon
                  i.mdi.mdi-download
                span Front
              a#dlCardBack.button.is-info.is-small(href="" download="" style="display: none;")
                span.icon
                  i.mdi.mdi-download
                span Back
              a#dlCardHolo.button.is-warning.is-small(href="" download="" style="display: none;")
                span.icon
                  i.mdi.mdi-download
                span Holo
              a#dlCardIr.button.is-dark.is-small(href="" download="" style="display: none;")
                span.icon
                  i.mdi.mdi-download
                span QR Code
          p#holoCardDesc.subtitle.is-7.has-text-grey-light.mb-0

    button#lightboxClose.modal-close.is-large(aria-label="close")
