doctype html
html(lang="en" data-theme="dark")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Asphyxia EA3 Uploader
    link(rel="stylesheet" href="/css/bulma.min.css")
    link(rel="stylesheet" href="/css/materialdesignicons.min.css")
    link(rel="stylesheet" href="/css/style.css")
  body
    nav.navbar.is-dark.has-shadow(role="navigation" aria-label="main navigation")
      .container
        .navbar-brand
          a.navbar-item.brand-link(href="/")
            span.icon.has-text-primary.brand-icon
              i.mdi.mdi-camera-burst.mdi-24px
            strong.has-text-white.brand-text Asphyxia EA3 Uploader
          .navbar-item.nav-port-item
            .tags.has-addons.mb-0
              span.tag.is-black.has-text-grey-lighter Port
              span.tag.is-primary.has-text-weight-bold #{config.PORT}

    section.section
      .container
        block content

    footer.footer.has-background-black-ter.has-text-centered.py-6.mt-6
      .container
        p.has-text-grey-light
          | Asphyxia EA3 Uploader

    script(src="/js/gallery.js")
